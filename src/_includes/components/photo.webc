<div class="photo">
  <button class="radius__m" :popovertarget="`${photo.directory}-${index}`" popovertargetaction="show">
    <figure class="photo__preview flow__grid flow__align--block-center flow__align--inline-center">
      <img :alt="`${photo.directory} photo #${index}`" class="radius__m shadow" :src="photo.file"
        sizes="(min-width: 640px) 320px, 160px" eleventy:widths="160, 320" fetchpriority="high" loading="lazy"
        data-square="true" />
    </figure>
  </button>
  <dialog :id="`${photo.directory}-${index}`" class="photo__details" popover :data-bg="photo.palette.muted.colorString">
    <section class="flow__grid overflow__hidden padding__m width__xl">
      <nav class="photo__nav flow__grid padding__m position__absolute">
        <button class="flow__inline flow__align--block-center flow__align--inline-center" title="Close open photo"
          :popovertarget="`${photo.directory}-${index}`" popovertargetaction="hide">
          <icon name="cancel" webc:nokeep></icon>
        </button>
        <section class="flow__flex flow__align--block-center flow__align--inline-between">
          <button class="flow__inline flow__align--block-center flow__align--inline-center"
            title="Choose previous photo" :disabled="prevdisabled" onclick="handlePrev()">
            <icon name="left" webc:nokeep></icon>
          </button>
          <button class="flow__inline flow__align--block-center flow__align--inline-center" title="Choose next photo"
            :disabled="nextdisabled" onclick="handleNext()">
            <icon name="right" webc:nokeep></icon>
          </button>
        </section>
      </nav>
      <img :alt="`${photo.directory} photo #${index}`" class="radius__m shadow" :src="photo.file"
        sizes="(min-width: 1008px) 1280px, (min-width: 800px) 960px, (min-width: 640px) 640px, 100vw"
        fetchpriority="low" />
      <figcaption class="photo__meta type__family--tertiary">
        <p class="padding__inline--l type__size--s-m" @text="`${photo.exif.Make} ${photo.exif.Model.replace(photo.exif.Make, '')} • ${(() => {
            const createDateMs = Date.parse(photo.exif.CreateDate);
            if (!Number.isFinite(createDateMs)) {
              return '';
            }

            const offsetMatch = /^([+-])(\d{2}):(\d{2})$/.exec(photo.exif.OffsetTime ?? '');
            const offsetMinutes = offsetMatch
              ? (offsetMatch[1] === '-' ? -1 : 1) *
                (Number(offsetMatch[2]) * 60 + Number(offsetMatch[3]))
              : 0;

            /* Apply the capture offset for display, then format in UTC to avoid viewer-local timezone shifts. */
            const displayDate = new Date(createDateMs + offsetMinutes * 60_000);

            return displayDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              hour: 'numeric',
              minute: 'numeric',
              timeZone: 'UTC'
            });
          })()} • ƒ${(() => {
            const fNumber = Number(photo.exif.FNumber);
            return Number.isFinite(fNumber) ? fNumber.toFixed(1) : '';
          })()} • ISO ${photo.exif.ISO} • ${Math.round(photo.exif.FocalLength)}mm`">
        </p>
      </figcaption>
    </section>
  </dialog>
</div>